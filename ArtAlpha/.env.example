# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/hono
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── ALERTS ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
SENDGRID_API_KEY=SG....
ALERT_FROM_EMAIL=alerts@hono.art

# ─── AUTH ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── STRIPE ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs (create at dashboard.stripe.com/products)
STRIPE_PRICE_STARTER_MONTHLY=price_
STRIPE_PRICE_STARTER_YEARLY=price_
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_PRO_YEARLY=price_
STRIPE_PRICE_EXPERT_MONTHLY=price_
STRIPE_PRICE_EXPERT_YEARLY=price_

# ─── ADMIN ───────────────────────────────────────────────────────────────────
# Comma-separated emails that get expert plan access automatically
ADMIN_EMAILS=your@email.com,demo@hono.art

# ─── SCRAPING (optional keys for real connectors) ────────────────────────────
INVALUABLE_API_KEY=
DROUOT_SESSION_COOKIE=
INTERENCHERES_API_KEY=

# ─── APP ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=HONO
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
DEAL_SCORE_THRESHOLD=75
POLL_INTERVAL_MINUTES=15

# ─── NEXT.JS PUBLIC ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=HONO
