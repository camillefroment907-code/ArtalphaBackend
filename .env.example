# ─── Nautilus Frontend — Environment Variables ────────────────────────────────
# Copy this file to .env.local for local development
# Production values go in Vercel environment variables (never commit .env.local)

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Backend API URL
VITE_API_URL=https://artalpha-backend-production.up.railway.app

# Stripe publishable key (safe to expose — used in frontend only)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── OPTIONAL (analytics — requires cookie consent) ──────────────────────────
# Microsoft Clarity heatmaps
# Get from: https://clarity.microsoft.com
VITE_CLARITY_ID=

# Google Analytics 4 measurement ID
# Get from: https://analytics.google.com
VITE_GA4_ID=
