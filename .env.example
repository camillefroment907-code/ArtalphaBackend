# ─── Nautilus Frontend — Environment Variables ────────────────────────────────
# Copy this file to .env.local for local development
# Production values go in Vercel environment variables (never commit .env.local)

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Backend API URL
VITE_API_URL=https://artalpha-backend-production.up.railway.app
VITE_BACKEND_URL=https://artalpha-backend-production.up.railway.app

# Stripe publishable key (safe to expose — used in frontend only)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Google OAuth client ID
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Anthropic API key (used client-side for AI analyst — expose only if intentional)
# Get from: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=

# ─── OPTIONAL (analytics — requires cookie consent) ──────────────────────────
# Microsoft Clarity heatmaps
# Get from: https://clarity.microsoft.com
VITE_CLARITY_ID=

# Google Analytics 4 measurement ID
# Get from: https://analytics.google.com
VITE_GA4_ID=
