{
  "name": "Nautilus — 01 Welcome Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nautilus-welcome",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "fromEmail": "hello@get-nautilus.com",
        "toEmail": "={{ $json.body.email }}",
        "subject": "Welcome to Nautilus — your first opportunity is waiting",
        "emailFormat": "html",
        "html": "<!DOCTYPE html><html><body style='background:#FAFAF8;font-family:Georgia,serif;margin:0;padding:40px 0'><table width='600' style='margin:0 auto;background:#fff;border:1px solid #E8E6E1'><tr><td style='padding:32px 40px;border-bottom:1px solid #E8E6E1'><span style='font-family:Georgia,serif;font-size:20px;font-weight:600;color:#0A1628;letter-spacing:0.05em'>NAUTI<span style='color:#C6A85A'>LUS</span></span></td></tr><tr><td style='padding:40px'><h1 style='font-family:Georgia,serif;font-size:28px;color:#0A1628;margin:0 0 16px'>Welcome, {{ $json.body.name }}.</h1><p style='font-size:15px;color:#5A6A7A;line-height:1.7;margin:0 0 24px'>Your account is active. The market is already surfacing opportunities — here is what to do next.</p><a href='https://app.get-nautilus.com/app/explore?tab=best' style='display:inline-block;background:#0A1628;color:#fff;padding:14px 28px;text-decoration:none;font-size:13px;font-weight:700;border-radius:6px'>See today's best lots →</a><p style='font-size:13px;color:#8A9AAA;margin:32px 0 0;line-height:1.6'>Questions? Reply to this email or chat with Larry (our AI) directly in the platform.</p></td></tr><tr><td style='padding:20px 40px;background:#F5F4F0;border-top:1px solid #E8E6E1;font-size:11px;color:#8A9AAA;font-family:monospace'>© 2026 Nautilus · <a href='https://get-nautilus.com/legal/privacy' style='color:#8A9AAA'>Privacy</a> · <a href='https://get-nautilus.com/legal/terms' style='color:#8A9AAA'>Terms</a></td></tr></table></body></html>",
        "options": {}
      },
      "id": "send-welcome",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [480, 300],
      "credentials": {
        "smtp": { "id": "resend-smtp", "name": "Resend SMTP" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\": \"sent\"}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Send Welcome Email", "type": "main", "index": 0 }]] },
    "Send Welcome Email": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["nautilus", "email", "onboarding"]
}
