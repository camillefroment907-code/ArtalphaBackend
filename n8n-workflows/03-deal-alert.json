{
  "name": "Nautilus — 03 Deal Alert Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nautilus-deal-alert",
        "responseMode": "responseNode"
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "fromEmail": "alerts@get-nautilus.com",
        "toEmail": "={{ $json.body.email }}",
        "subject": "◆ Deal Alert: {{ $json.body.artist }} — Score {{ $json.body.score }}/100",
        "emailFormat": "html",
        "html": "<!DOCTYPE html><html><body style='background:#FAFAF8;font-family:Georgia,serif;margin:0;padding:40px 0'><table width='600' style='margin:0 auto;background:#fff;border:1px solid #E8E6E1'><tr><td style='padding:32px 40px;border-bottom:1px solid #E8E6E1'><span style='font-size:20px;font-weight:600;color:#0A1628'>NAUTI<span style='color:#C6A85A'>LUS</span></span></td></tr><tr><td style='padding:40px'><div style='font-size:11px;font-weight:700;color:#C6A85A;font-family:monospace;letter-spacing:0.1em;margin-bottom:16px'>◆ DEAL ALERT</div><h1 style='font-family:Georgia,serif;font-size:24px;color:#0A1628;margin:0 0 8px'>{{ $json.body.title }}</h1><div style='font-size:14px;color:#5A6A7A;margin-bottom:24px'>{{ $json.body.artist }} · {{ $json.body.auction_house }}</div><div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:24px'><div style='background:#F5F4F0;border-radius:6px;padding:14px;text-align:center'><div style='font-size:10px;font-weight:700;color:#8A9AAA;font-family:monospace;letter-spacing:0.1em;margin-bottom:6px'>SCORE</div><div style='font-size:22px;font-weight:700;font-family:monospace;color:#C6A85A'>{{ $json.body.score }}</div></div><div style='background:#F5F4F0;border-radius:6px;padding:14px;text-align:center'><div style='font-size:10px;font-weight:700;color:#8A9AAA;font-family:monospace;letter-spacing:0.1em;margin-bottom:6px'>ESTIMATE</div><div style='font-size:14px;font-weight:700;font-family:monospace;color:#0A1628'>€{{ $json.body.estimate }}</div></div><div style='background:#F5F4F0;border-radius:6px;padding:14px;text-align:center'><div style='font-size:10px;font-weight:700;color:#8A9AAA;font-family:monospace;letter-spacing:0.1em;margin-bottom:6px'>UPSIDE</div><div style='font-size:14px;font-weight:700;font-family:monospace;color:#2563EB'>+{{ $json.body.upside }}%</div></div></div><a href='https://app.get-nautilus.com/app/opportunities/{{ $json.body.lot_id }}' style='display:inline-block;background:#0A1628;color:#fff;padding:14px 28px;text-decoration:none;font-size:13px;font-weight:700;border-radius:6px'>Analyser cette opportunité →</a><p style='font-size:11px;color:#8A9AAA;margin:20px 0 0;line-height:1.6'>This alert was generated by Nautilus AI. Not financial advice.</p></td></tr><tr><td style='padding:20px 40px;background:#F5F4F0;border-top:1px solid #E8E6E1;font-size:11px;color:#8A9AAA;font-family:monospace'>© 2026 Nautilus · <a href='https://app.get-nautilus.com/app/alerts' style='color:#8A9AAA'>Manage alerts</a></td></tr></table></body></html>"
      },
      "id": "send-deal-alert",
      "name": "Send Deal Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [480, 300],
      "credentials": { "smtp": { "id": "resend-smtp", "name": "Resend SMTP" } }
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "{\"status\": \"sent\"}" },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Send Deal Alert", "type": "main", "index": 0 }]] },
    "Send Deal Alert": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["nautilus", "email", "alerts"]
}
