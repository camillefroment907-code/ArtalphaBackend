  "connections": {
    "Webhook": { "main": [[{ "node": "Send Subscription Confirmed", "type": "main", "index": 0 }]] },
    "Send Subscription Confirmed": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
