    {
      "parameters": { "respondWith": "json", "responseBody": "{\"status\": \"sent\"}" },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 300]
    }
